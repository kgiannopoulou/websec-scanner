          "level": "note",
          "message": {
            "text": "Missing security header: permissions-policy. The response did not include a 'permissions-policy' header. Fix: Add a 'Permissions-Policy' header to explicitly disable browser features (camera, microphone, geolocation, etc.) your site doesn't use."
          },
          "locations": [
