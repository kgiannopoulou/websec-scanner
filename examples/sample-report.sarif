        {
          "ruleId": "WSS-HDR-005",
          "level": "note",
          "message": {
            "text": "Missing security header: referrer-policy. The response did not include a 'referrer-policy' header. Fix: Add a 'Referrer-Policy' header (e.g. 'strict-origin-when-cross-origin') to avoid leaking full URLs to third-party sites via the Referer header."
          },
          "locations": [
