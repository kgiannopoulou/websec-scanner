        {
          "ruleId": "WSS-HDR-001",
          "level": "warning",
          "message": {
            "text": "Missing security header: content-security-policy. The response did not include a 'content-security-policy' header. Fix: Add a Content-Security-Policy header to restrict which scripts, styles, and resources the browser may load, mitigating XSS and data-injection attacks."
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "https://kgiannopoulou.github.io/website-portfolio/"
                }
              }
            }
          ],
          "properties": {
            "severity": "medium",
            "security-severity": "5.5"
          }
        },
        {
          "ruleId": "WSS-HDR-003",
          "level": "note",
          "message": {
            "text": "Missing security header: x-content-type-options. The response did not include a 'x-content-type-options' header. Fix: Add 'X-Content-Type-Options: nosniff' to stop browsers from MIME-sniffing responses away from the declared Content-Type."
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "https://kgiannopoulou.github.io/website-portfolio/"
                }
              }
            }
          ],
          "properties": {
