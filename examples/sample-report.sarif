            "security-severity": "3.0"
          }
        },
        {
          "ruleId": "WSS-HDR-004",
          "level": "warning",
          "message": {
            "text": "Missing security header: x-frame-options. The response did not include a 'x-frame-options' header. Fix: Add 'X-Frame-Options: DENY' or 'SAMEORIGIN' (or a frame-ancestors CSP directive) to prevent clickjacking via iframes."
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
