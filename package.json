{
  "name": "websec-scanner",
  "version": "1.1.0",
  "description": "CLI tool that scans a website for common security misconfigurations (headers, cookies, TLS, exposed files, CORS) and produces a remediation report.",
  "type": "module",
  "bin": {
    "websec-scanner": "./dist/index.js"
  },
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsc && node dist/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "check": "npm run lint && npm run typecheck && npm test && npm run build"
  },
  "keywords": [
    "security",
    "scanner",
    "owasp",
    "cli",
    "cybersecurity"
  ],
  "author": "Konstantina Giannopoulou",
  "license": "MIT",
  "dependencies": {
    "chalk": "^5.3.0",
    "commander": "^12.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^22.10.2",
    "eslint": "^9.39.5",
    "globals": "^17.13.0",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.72.0",
    "vitest": "^3.2.7"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
