{
  "name": "websec-scanner",
  "version": "1.0.0",
  "description": "CLI tool that scans a website for common security misconfigurations (headers, cookies, TLS, exposed files, CORS) and produces a remediation report.",
  "type": "module",
  "bin": {
    "websec-scanner": "./dist/index.js"
  },
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsc && node dist/index.js"
  },
  "keywords": ["security", "scanner", "owasp", "cli", "cybersecurity"],
  "author": "Konstantina Giannopoulou",
  "license": "MIT",
  "dependencies": {
    "chalk": "^5.3.0",
    "commander": "^12.1.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "typescript": "^5.7.2"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
